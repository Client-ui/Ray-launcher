# Maintainer: Ray <maintainer@example.com>
pkgname=rayclient-bin
_appname=RayLauncher
pkgver=2.0.1
pkgrel=1
pkgdesc="Next-generation open source Minecraft launcher (prebuilt)"
arch=('x86_64')
url="https://github.com/your-org/RayLauncher"
license=('GPL-3.0-only')
depends=(
  'fontconfig'
  'freetype2'
  'libglvnd'
  'libxcursor'
  'libxrandr'
  'libxi'
  'libxkbcommon'
  'wayland'
  'dbus'
)
provides=('rayclient')
conflicts=('rayclient')
options=('!strip')
_debfile="${_appname}_${pkgver}_linux_x86_64.deb"
source=("${_debfile}::${url}/releases/download/rayclient-${pkgver}/${_debfile}")
sha256sums=('SKIP')

package() {
  cd "$pkgdir"
  bsdtar -xf "$srcdir/$_debfile"
  bsdtar -xf data.tar.*
  rm -f debian-binary control.tar.* data.tar.*

  ln -s rayclient_app "$pkgdir/usr/bin/rayclient"
}
