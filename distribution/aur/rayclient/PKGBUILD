# Maintainer: Ray <maintainer@example.com>
pkgname=rayclient
pkgver=2.0.1
pkgrel=1
pkgdesc="Next-generation open source Minecraft launcher (built from source)"
arch=('x86_64')
url="https://github.com/your-org/RayLauncher"
license=('GPL-3.0-only')
depends=(
  'fontconfig'
  'freetype2'
  'libglvnd'
  'libxcursor'
  'libxrandr'
  'libxi'
  'libxkbcommon'
  'wayland'
  'dbus'
)
makedepends=(
  'rust'
  'cargo'
  'cmake'
  'clang'
  'pkgconf'
  'python'
)
provides=('rayclient')
conflicts=('rayclient-bin')
options=(
  '!lto'
  '!debug'
)
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/rayclient-${pkgver}.tar.gz")
sha256sums=('SKIP')

_srcdir="RayLauncher-rayclient-${pkgver}"

prepare() {
  cd "$srcdir/$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen --bin rayclient_app
}

package() {
  cd "$srcdir/$_srcdir"
  local appdir="packages/rayclient_app"

  install -Dm755 "target/release/rayclient_app" "$pkgdir/usr/bin/rayclient_app"
  ln -s rayclient_app "$pkgdir/usr/bin/rayclient"

  install -dm755 "$pkgdir/usr/share/applications"
  sed -e 's|{{exec}}|rayclient_app|g' \
      -e 's|{{icon}}|dev.ray.RayLauncher|g' \
      "$appdir/distribution/linux/dev.ray.rayclient.template" \
      > "$pkgdir/usr/share/applications/dev.ray.RayLauncher.desktop"

  install -Dm644 "$appdir/icons/32x32.png"    "$pkgdir/usr/share/icons/hicolor/32x32/apps/dev.ray.RayLauncher.png"
  install -Dm644 "$appdir/icons/128x128.png"  "$pkgdir/usr/share/icons/hicolor/128x128/apps/dev.ray.RayLauncher.png"
  install -Dm644 "$appdir/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/dev.ray.RayLauncher.png"
  install -Dm644 "$appdir/icons/512x512.png"  "$pkgdir/usr/share/icons/hicolor/512x512/apps/dev.ray.RayLauncher.png"
}
